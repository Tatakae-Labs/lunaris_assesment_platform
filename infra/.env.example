# Environment Configuration for Lunaris Assessment SaaS
PROJECT_NAME="Lunaris JEE Assessment Platform"
ENVIRONMENT=development
SECRET_KEY=lunaris_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./lunaris.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lunaris_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_assets
# AWS_S3_BUCKET=lunaris-evidence-vault
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Proctoring Settings
PROCTORING_SNAPSHOT_INTERVAL_SEC=10
VOICE_DETECTION_ENABLED=true
BROWSER_LOCKDOWN_ENABLED=true
