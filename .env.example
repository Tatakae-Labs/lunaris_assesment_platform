# ==============================================================================
# Lunaris Assessment Platform - Environment Configuration Template
# ==============================================================================

# Application & Environment
PROJECT_NAME="Lunaris Assessment Platform"
ENVIRONMENT=production
DEBUG=false
API_V1_STR="/api/v1"

# Cryptography & Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Production, SQLite for Local Dev)
DATABASE_URL=postgresql://lunaris_user:secure_password@localhost:5432/lunaris_db
# DATABASE_URL=sqlite:///./lunaris.db

# MongoDB Configuration (Local Document & Telemetry Store)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=lunaris

# CORS Allowed Origins (Comma-separated list of front-end origins)
CORS_ORIGINS=["https://app.lunaris.org", "https://exam.lunaris.org", "http://localhost:5173"]

# Storage Service Configuration
STORAGE_BACKEND=local
# Set to 's3' for production AWS S3 / Cloudflare R2 / MinIO
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=lunaris-evidence-vault
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
LOCAL_STORAGE_DIR=./storage_assets

# Proctoring & Telemetry Policies
PROCTORING_SNAPSHOT_INTERVAL_SEC=12
VOICE_DETECTION_ENABLED=true
BROWSER_LOCKDOWN_ENABLED=true
EVIDENCE_RETENTION_DAYS=90

# AI Question Studio (Groq LLM Provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
