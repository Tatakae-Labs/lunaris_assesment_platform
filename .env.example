# Lunaris Environment Configuration Reference
PROJECT_NAME="Lunaris JEE Assessment Platform"
ENVIRONMENT=development
SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=sqlite:///./lunaris.db
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_assets
PROCTORING_SNAPSHOT_INTERVAL_SEC=10
VOICE_DETECTION_ENABLED=true
BROWSER_LOCKDOWN_ENABLED=true
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=lunaris

# SMTP / Mailer Service Configuration (All secrets managed via .env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@lunaris.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=notifications@lunaris.com
SMTP_FROM_NAME="Lunaris Assessment Platform"
SMTP_TLS=true
SMTP_SSL=false
